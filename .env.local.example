# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings > API in the Supabase dashboard).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key: keeps full database/storage access, bypassing Row Level Security.
# NEVER expose this in client code or commit it. Used only in server actions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional but recommended: email the Trust admin whenever a student submits an
# application. Without these two set, the app still works — submissions just
# won't trigger an email. Get an API key free at https://resend.com.
RESEND_API_KEY=your-resend-api-key
ADMIN_NOTIFICATION_EMAIL=trust-admin@example.com
# Sender address. Until you verify your own domain in Resend, leave this as
# onboarding@resend.dev (Resend's shared test sender).
NOTIFICATION_FROM_EMAIL=onboarding@resend.dev

# Browser push notifications for the admin dashboard — no third-party account
# needed. Generate your own keypair once with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# and never rotate it without also clearing everyone's saved subscriptions.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-generated-public-key
VAPID_PRIVATE_KEY=your-generated-private-key
VAPID_SUBJECT=mailto:trust-admin@example.com
